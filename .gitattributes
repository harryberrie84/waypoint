# Normalise everything to LF in the repo. The app is built in a Linux container,
# and a CRLF shebang breaks a script with:
#   /usr/bin/env: 'bash\r': No such file or directory
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.woff2 binary
*.zip binary
