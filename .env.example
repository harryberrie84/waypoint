# Waypoint configuration. Every value is optional: the defaults are what the
# Docker image runs with, and the app works with none of this set.

# --- container ---------------------------------------------------------------
# Create the PocketBase admin account on first start. Only used when the database
# is brand new; leave both unset and PocketBase prints a one-time setup link in
# `docker compose logs` instead. The admin account is for the /_/ dashboard (SMTP,
# backups), not for using the app: you register a normal account for that.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=

# Port inside the container. Change the published port in docker-compose.yml
# instead unless you have a reason to move this one.
# PB_PORT=8090

# --- build-time (only if you build the frontend yourself) --------------------
# Set only when the SPA is served from a DIFFERENT origin than PocketBase. The
# supported deploy serves both from one port, where the app talks to its own
# origin and this must stay unset.
# Example for a split dev setup (vite on :5173, PocketBase on :8090):
# VITE_PB_URL=http://127.0.0.1:8090

# Routing server for travel time and distance in the Route view. Unset uses the
# public OSRM demo, which is driving-only and rate-limited. Point this at your own
# for walking and cycling profiles, and so route lookups leave no third party.
# VITE_OSRM_URL=https://osrm.example.org
